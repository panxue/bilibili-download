# Docker Compose environment variables example — copy to .env and fill in as needed (.env is not committed)
# compose.yaml reads it via env_file, overriding the defaults built into backend/config.py.

# Auth token. Empty = loopback access only; non-empty = the userscript "Settings" panel must hold the same value
# BLDLP_TOKEN=

# Max concurrent download jobs (default 2)
# BLDLP_CONCURRENT=2

# Proxy, empty = direct. Example: socks5://127.0.0.1:1080 (must be reachable from inside the container)
# BLDLP_PROXY=
